{
  "targetToolType": ["REPEATER","INTRUDER","SCANNER","EXTENSIONS"],

  "preScriptParameterName": "YASC_PRE_SCRIPT",
  "preScriptParameterType": "URL",

  "postScriptParameterName": "YASC_POST_SCRIPT",
  "postScriptParameterType": "URL",

  "disablePreScriptParameterName": "YASC_PRE_SCRIPT_DISABLED",
  "disablePreScriptParameterType": "URL",

  "disablePostScriptParameterName": "YASC_POST_SCRIPT_DISABLED",
  "disablePostScriptParameterType": "URL",

